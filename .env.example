# Bot token from @BotFather. Keep it secret and never commit it.
BOT_TOKEN=123456:ABC-your-token

# Private channel ID (starts with -100). To find it, forward any channel post to the bot.
CHANNEL_ID=-1001234567890

# Your Telegram ID (send /id to the bot). Several IDs: comma-separated.
ADMIN_IDS=123456789

# Support username, without @
SUPPORT_USERNAME=your_support_username

# Local runs use SQLite. docker-compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# How often to check subscriptions (minutes)
CHECK_INTERVAL_MINUTES=10

# Plan prices in Telegram Stars (minimum 1)
PRICE_MONTH=250
PRICE_QUARTER=600
PRICE_LIFETIME=1500

# Postgres password for docker-compose. Generate one, e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=change_me
