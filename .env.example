# Токен из @BotFather. Никому не показывай и не заливай в GitHub.
BOT_TOKEN=123456:ABC-your-token

# ID закрытого канала (начинается с -100). Узнать: перешли боту любой пост из канала.
CHANNEL_ID=-1001234567890

# Твой Telegram ID (узнать: команда /id в боте). Несколько — через запятую.
ADMIN_IDS=123456789

# Юзернейм для поддержки, без @
SUPPORT_USERNAME=your_support_username

# Локально — SQLite. В docker-compose переопределяется на Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Как часто проверять подписки (минуты)
CHECK_INTERVAL_MINUTES=10
